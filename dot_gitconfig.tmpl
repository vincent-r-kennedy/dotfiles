# Fail-closed: no identity and no SSH key at the global level.
# Each entity dir under ~/projects/<entity>/ gets its own via includeIf below —
# anything outside an entity dir cannot commit or authenticate to GitHub.
[user]
	useConfigOnly = true
[core]
	editor = nano
	excludesFile = ~/.gitignore_global
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true

[includeIf "gitdir:~/projects/vincent/"]
	path = ~/.gitconfig-vincent
[includeIf "gitdir:~/projects/vicoco/"]
	path = ~/.gitconfig-vicoco

# Local overrides (not tracked by chezmoi)
[include]
	path = ~/.gitconfig.local
